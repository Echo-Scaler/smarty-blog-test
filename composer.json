{
    "name": "myproject/blog",
    "description": "Simple Blog with Smarty",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "smarty/smarty": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}